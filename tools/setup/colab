#!/usr/bin/env bash
# Description: One-stop Colab init: mount Google Drive, authenticate gh from secrets or Drive, restore agy token
set -eo pipefail

TOOLBOX_ROOT="$(cd -P "$(dirname "${BASH_SOURCE[0]}")/../.." >/dev/null 2>&1 && pwd)"
# shellcheck source=tools/lib/common.sh
source "${TOOLBOX_ROOT}/tools/lib/common.sh"

log_header "Google Colab Environment Initialization"

# 1. Mount Google Drive if not already mounted
log_info "Step 1/3: Checking Google Drive mount..."
if is_drive_mounted; then
    log_success "Google Drive is already mounted at /content/drive"
else
    ensure_drive_mounted "/content/drive"
fi
log_success "Google Drive ready."

# 2. Authenticate GitHub CLI from Colab Secrets or Google Drive backup
log_info "Step 2/3: Configuring GitHub CLI authentication..."
if "${TOOLBOX_ROOT}/tools/setup/gh"; then
    log_success "GitHub CLI configured."
else
    log_warn "GitHub CLI setup encountered issues. You can re-run './toolbox setup gh' independently."
fi

# 3. Restore Antigravity OAuth Token
log_info "Step 3/3: Restoring Antigravity CLI token..."
if "${TOOLBOX_ROOT}/tools/setup/agy" restore; then
    log_success "Antigravity CLI token restored."
else
    log_warn "Antigravity token restore encountered issues. Check if backup exists or save one with './toolbox setup agy save'."
fi

log_header "Initialization Summary"
log_success "Colab setup sequence finished."
