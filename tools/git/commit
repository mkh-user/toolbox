#!/usr/bin/env bash
# Description: Smart conventional commit authoring tool (interactive or flag-based)
set -eo pipefail

TOOLBOX_ROOT="$(cd -P "$(dirname "${BASH_SOURCE[0]}")/../.." >/dev/null 2>&1 && pwd)"
# shellcheck source=tools/lib/common.sh
source "${TOOLBOX_ROOT}/tools/lib/common.sh"

log_header "Conventional Commit Helper"

# Verify in git repo
if ! git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    log_error "Not inside a git repository."
    exit 1
fi

# Verify staged changes exist
if git diff --cached --quiet; then
    log_warn "No changes staged for commit."
    printf "\nRun ${BOLD}git add <files>${RESET} to stage changes, or run ${BOLD}./toolbox git diff-sum${RESET} to review.\n\n"
    exit 1
fi

COMMIT_TYPE=""
SCOPE=""
SUBJECT=""
BODY=""

show_usage() {
    printf "${BOLD}Usage:${RESET}\n"
    printf "  ./toolbox git commit [options]\n\n"
    printf "${BOLD}Options:${RESET}\n"
    printf "  -t, --type <type>        Commit type (feat, fix, docs, refactor, test, chore, perf, style)\n"
    printf "  -s, --scope <scope>      Optional scope (e.g. setup, colab, cli)\n"
    printf "  -m, --message <subject>  Commit subject line (imperative, lower case)\n"
    printf "  -b, --body <body>        Optional commit body description\n"
    printf "  -h, --help               Show this help message\n\n"
}

while [[ $# -gt 0 ]]; do
    case "$1" in
        -t|--type)
            COMMIT_TYPE="$2"
            shift 2
            ;;
        -s|--scope)
            SCOPE="$2"
            shift 2
            ;;
        -m|--message)
            SUBJECT="$2"
            shift 2
            ;;
        -b|--body)
            BODY="$2"
            shift 2
            ;;
        -h|--help)
            show_usage
            exit 0
            ;;
        *)
            # If a naked string argument is passed, treat as subject message
            if [[ -z "$SUBJECT" ]]; then
                SUBJECT="$1"
                shift
            else
                log_error "Unknown option: $1"
                show_usage
                exit 1
            fi
            ;;
    esac
done

# Interactive mode if arguments are missing
if [[ -z "$COMMIT_TYPE" ]]; then
    printf "${BOLD}Select commit type:${RESET}\n"
    printf "  1) feat     (New feature / user-facing capability)\n"
    printf "  2) fix      (Bug fix)\n"
    printf "  3) docs     (Documentation changes only)\n"
    printf "  4) refactor (Code change that neither fixes a bug nor adds a feature)\n"
    printf "  5) test     (Adding or updating tests)\n"
    printf "  6) chore    (Maintenance, build tooling, repository hygiene)\n"
    printf "  7) perf     (Performance improvement)\n"
    read -r -p "Enter number [1-7]: " type_num
    case "$type_num" in
        1) COMMIT_TYPE="feat" ;;
        2) COMMIT_TYPE="fix" ;;
        3) COMMIT_TYPE="docs" ;;
        4) COMMIT_TYPE="refactor" ;;
        5) COMMIT_TYPE="test" ;;
        6) COMMIT_TYPE="chore" ;;
        7) COMMIT_TYPE="perf" ;;
        *) COMMIT_TYPE="chore" ;;
    esac
fi

if [[ -z "$SCOPE" && -t 0 ]]; then
    read -r -p "Enter optional scope (press Enter to skip): " input_scope
    SCOPE="$input_scope"
fi

if [[ -z "$SUBJECT" ]]; then
    read -r -p "Enter commit subject (imperative sentence): " input_subject
    SUBJECT="$input_subject"
fi

if [[ -z "$SUBJECT" ]]; then
    log_error "Commit subject cannot be empty."
    exit 1
fi

# Clean subject (lowercase first letter if standard ASCII)
first_char="$(echo "${SUBJECT:0:1}" | tr '[:upper:]' '[:lower:]')"
SUBJECT="${first_char}${SUBJECT:1}"

# Construct title
if [[ -n "$SCOPE" ]]; then
    FULL_TITLE="${COMMIT_TYPE}(${SCOPE}): ${SUBJECT}"
else
    FULL_TITLE="${COMMIT_TYPE}: ${SUBJECT}"
fi

printf "\n${BOLD}Commit Preview:${RESET}\n"
printf "  ${CYAN}%s${RESET}\n" "$FULL_TITLE"
if [[ -n "$BODY" ]]; then
    printf "  %s\n" "$BODY"
fi
printf "\n"

# Execute commit
if [[ -n "$BODY" ]]; then
    git commit -m "$FULL_TITLE" -m "$BODY"
else
    git commit -m "$FULL_TITLE"
fi

log_success "Committed successfully."
