#!/usr/bin/env bash
# Description: Summarize staged, unstaged, and untracked changes with change stats
set -eo pipefail

TOOLBOX_ROOT="$(cd -P "$(dirname "${BASH_SOURCE[0]}")/../.." >/dev/null 2>&1 && pwd)"
# shellcheck source=tools/lib/common.sh
source "${TOOLBOX_ROOT}/tools/lib/common.sh"

log_header "Git Working Tree Summary"

# Check if inside git repo
if ! git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    log_error "Not inside a git repository."
    exit 1
fi

BRANCH="$(git branch --show-current 2>/dev/null || echo "detached")"
printf "${BOLD}Current Branch:${RESET} ${CYAN}%s${RESET}\n\n" "$BRANCH"

# 1. Staged Changes
STAGED="$(git diff --cached --name-status 2>/dev/null || true)"
printf "${BOLD}[1] Staged Changes (Ready to commit):${RESET}\n"
if [[ -n "$STAGED" ]]; then
    while IFS=$'\t' read -r status file; do
        case "$status" in
            A*) printf "  ${GREEN}[+] Added:${RESET}    %s\n" "$file" ;;
            M*) printf "  ${BLUE}[~] Modified:${RESET} %s\n" "$file" ;;
            D*) printf "  ${RED}[-] Deleted:${RESET}  %s\n" "$file" ;;
            R*) printf "  ${MAGENTA}[R] Renamed:${RESET}  %s\n" "$file" ;;
            *)  printf "  [%s] %s\n" "$status" "$file" ;;
        esac
    done <<< "$STAGED"
    printf "\n"
    git diff --cached --stat | sed 's/^/    /'
else
    printf "  ${DIM}(No staged changes)${RESET}\n"
fi

# 2. Unstaged Changes
UNSTAGED="$(git diff --name-status 2>/dev/null || true)"
printf "\n${BOLD}[2] Unstaged Changes:${RESET}\n"
if [[ -n "$UNSTAGED" ]]; then
    while IFS=$'\t' read -r status file; do
        case "$status" in
            M*) printf "  ${YELLOW}[~] Modified:${RESET} %s\n" "$file" ;;
            D*) printf "  ${RED}[-] Deleted:${RESET}  %s\n" "$file" ;;
            *)  printf "  [%s] %s\n" "$status" "$file" ;;
        esac
    done <<< "$UNSTAGED"
    printf "\n"
    git diff --stat | sed 's/^/    /'
else
    printf "  ${DIM}(No unstaged modifications)${RESET}\n"
fi

# 3. Untracked Files
UNTRACKED="$(git ls-files --others --exclude-standard 2>/dev/null || true)"
printf "\n${BOLD}[3] Untracked Files:${RESET}\n"
if [[ -n "$UNTRACKED" ]]; then
    while read -r file; do
        printf "  ${MAGENTA}[?] Untracked:${RESET} %s\n" "$file"
    done <<< "$UNTRACKED"
else
    printf "  ${DIM}(No untracked files)${RESET}\n"
fi

printf "\n"
